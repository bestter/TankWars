# Normaliser tous les fichiers texte dans l'index Git.
* text=auto eol=lf

# Les formats binaires ne doivent subir aucune conversion de fin de ligne.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
