# Copy to .env.production for manual production builds, or let deploy-cloudflare.ps1 set this.
# Option B: Worker deployed on workers.dev (separate from Cloudflare Pages).
VITE_API_BASE=https://tankwars-api.YOUR_SUBDOMAIN.workers.dev

# Production online: false. Staging local/hotseat with no network features: true.
VITE_HOTSEAT_ONLY=false
